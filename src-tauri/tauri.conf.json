{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Swayfi",
  "version": "0.1.6",
  "identifier": "app.swayfi.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Swayfi",
        "width": 900,
        "height": 600,
        "minWidth": 560,
        "minHeight": 460,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/vips",
      "binaries/pandoc",
      "binaries/7z",
      "binaries/mutool"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" }
    }
  }
}
